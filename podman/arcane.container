[Unit]
After=authentik-server.container
After=podman.socket
BindsTo=podman.socket

[Container]
ContainerName=arcane
Environment=TZ=Europe/Paris
Environment=ARCANE_APP_URL=https://arcane.internal.${MAIN_DOMAIN}
Environment=ARCANE_OIDC_ENABLED=true
Environment=ARCANE_OIDC_AUTO_REDIRECT_TO_PROVIDER=true
Environment=ARCANE_OIDC_PROVIDER_NAME=Authentik
Environment=ARCANE_OIDC_ISSUER_URL=https://authentik.${MAIN_DOMAIN}/application/o/arcane/
Environment=ARCANE_OIDC_SCOPES="openid profile email arcane_roles"
Environment=ARCANE_OIDC_GROUPS_CLAIM=arcane_roles
Environment=ARCANE_OIDC_ROLE_MAPPING=[{"claimValue":"arcane-admins","roleId":"role_admin"}]
Environment=PUID=0
Environment=PGID=0
Environment=ARCANE_TRUSTED_PROXIES=172.25.0.0/16
EnvironmentFile=/etc/secc/env/arcane.env
HealthCmd=["CMD", "./arcane", "health", "--timeout", "2s"]
HealthStartPeriod=15s
Image=ghcr.io/getarcaneapp/manager:v3.2
Label=traefik.enable=true
Label=traefik.http.routers.arcane.rule=Host(`arcane.internal.${MAIN_DOMAIN}`)
Label=traefik.http.routers.arcane.entrypoints=websecure
Label=traefik.http.routers.arcane.middlewares=tailscaleAL
Network=net-proxy.network
PodmanArgs=--cgroupns=host
Volume=/data/arcane:/app/data
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
Volume=/var/run/podman/podman.sock:/var/run/docker.sock
