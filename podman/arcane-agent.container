[Unit]
After=podman.socket
BindsTo=podman.socket

[Container]
ContainerName=arcane-agent
Environment=TZ=Europe/Paris
Environment=AGENT_MODE=true
Environment=EDGE_TRANSPORT=poll
Environment=MANAGER_API_URL=http://arcane:3552
Environment=PUID=0
Environment=PGID=0
EnvironmentFile=/etc/secc/env/arcane-agent.env
Image=ghcr.io/getarcaneapp/agent:v2.17
HealthCmd=["CMD", "./arcane", "health", "--timeout", "2s"]
HealthStartPeriod=15s
Network=net-proxy.network
Volume=/var/run/podman/podman.sock:/var/run/docker.sock
Volume=/data/arcane-agent:/app/data
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
