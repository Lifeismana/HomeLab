[Unit]
After=postgres.container
Requires=postgres.container

[Container]
ContainerName=postgres-exporter
Environment=DATA_SOURCE_USER=postgres
EnvironmentFile=/etc/secc/env/postgres-exporter.env
Exec=--datasource.uri=postgres:5432/postgres?sslmode=disable
Image=quay.io/prometheuscommunity/postgres-exporter:v0.21.1
Network=net-postgres.network
Network=net-prometheus.network
