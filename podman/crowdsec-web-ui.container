[Unit]
After=authentik-server.container
After=crowdsec.container
Requires=crowdsec.container

[Container]
ContainerName=crowdsec-web-ui
Environment=TZ=Europe/Paris
Environment=CONFIG_INSTANCE_ID=default
Environment=CONFIG_INSTANCE_NAME=CrowdSec
Environment=CONFIG_INSTANCE_LAPI_URL=http://crowdsec:8080
Environment=CONFIG_INSTANCE_LAPI_AUTH_USERNAME=crowdsec-web-ui
Environment=CONFIG_INSTANCE_METRICS_ID=lapi
Environment=CONFIG_INSTANCE_METRICS_NAME=CrowdSec
Environment=CONFIG_INSTANCE_METRICS_URL=http://crowdsec:6060/metrics
Environment=CONFIG_AUTH_ENABLED=auto
Environment=CONFIG_AUTH_PASSWORD_LOGIN_ENABLED=false
Environment=CONFIG_AUTH_OIDC_ISSUER_URL=https://authentik.${MAIN_DOMAIN}/application/o/crowdsec-web-ui/
Environment=CONFIG_AUTH_OIDC_SCOPE="openid profile email"
Environment=CONFIG_AUTH_OIDC_GROUPS_CLAIM=groups
Environment=CONFIG_AUTH_OIDC_ADMIN_GROUPS=[crowdsec-admins]
Environment=CONFIG_AUTH_OIDC_UNMATCHED_ROLE=deny
Environment=CONFIG_AUTH_OIDC_END_SESSION=true
Environment=CONFIG_AUTH_OIDC_AUTO_LOGIN=true
EnvironmentFile=/etc/secc/env/crowdsec-web-ui.env
Image=ghcr.io/theduffman85/crowdsec-web-ui:2026.11.12
Label=traefik.enable=true
Label=traefik.http.routers.crowdsec-web-ui.rule=Host(`crowdsec.internal.${MAIN_DOMAIN}`)
Label=traefik.http.routers.crowdsec-web-ui.entrypoints=websecure
Label=traefik.http.routers.crowdsec-web-ui.middlewares=tailscaleAL
Label=traefik.http.routers.crowdsec-web-ui.service=crowdsec-web-ui
Label=traefik.http.services.crowdsec-web-ui.loadbalancer.server.port=3000
Label=homepage.group=Main
Label=homepage.name=CrowdSec
Label=homepage.icon=crowdsec.png
Label=homepage.href=https://crowdsec.internal.${MAIN_DOMAIN}
Label=homepage.description="CrowdSec Web UI"
Network=net-proxy.network
Volume=/data/crowdsec-web-ui:/app/data
