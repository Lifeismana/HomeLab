[Unit]
Requires=postgres.service
Requires=redis.service
After=postgres.service
After=redis.service

[Container]
AddCapability=CAP_NET_BIND_SERVICE
ContainerName=forgejo
User=103:113
Environment=USER_UID=103
Environment=USER_GID=113
Environment=FORGEJO__SERVICE__DISABLE_REGISTRATION=false
Environment=FORGEJO__SERVICE__ENABLE_BASIC_AUTHENTICATION=false
Environment=FORGEJO__SERVICE__ENABLE_PASSWORD_SIGNIN_FORM=false
Environment=FORGEJO__SERVICE__ALLOW_ONLY_EXTERNAL_REGISTRATION=true
Environment=FORGEJO__OAUTH2_CLIENT__ENABLE_AUTO_REGISTRATION=true
Environment=FORGEJO__OPENID__ENABLE_OPENID_SIGNIN=false
Environment=FORGEJO__SERVER__DOMAIN=git.${MAIN_DOMAIN}
Environment=FORGEJO__SERVER__ROOT_URL=https://git.${MAIN_DOMAIN}/
Environment=FORGEJO__SERVER__LFS_START_SERVER=true
Environment=FORGEJO__DATABASE__DB_TYPE=postgres
Environment=FORGEJO__DATABASE__HOST=postgres:5432
Environment=FORGEJO__DATABASE__NAME=forgejodb
Environment=FORGEJO__DATABASE__USER=forgejo
Environment=FORGEJO__CACHE__ADAPTER=redis
Environment=FORGEJO__CACHE__HOST=redis://redis:6379/10?pool_size=100&idle_timeout=180s
Environment=FORGEJO__SESSION__PROVIDER=redis
Environment=FORGEJO__SESSION__PROVIDER_CONFIG=redis://redis:6379/10?pool_size=100&idle_timeout=180s
Environment=FORGEJO__SERVER__SSH_PORT=22
Environment=FORGEJO__SERVER__SSH_LISTEN_PORT=22
Environment=FORGEJO__SERVER__OFFLINE_MODE=false
EnvironmentFile=/etc/secc/env/forgejo.env
HealthCmd=["curl","-f","http://localhost:3000/api/healthz"]
HealthStartPeriod=30s
Image=codeberg.org/forgejo/forgejo:17-rootless
Label=traefik.enable=true
Label=traefik.http.routers.forgejo.rule=Host(`git.${MAIN_DOMAIN}`)
Label=traefik.http.routers.forgejo.entrypoints=websecure
Label=traefik.http.services.forgejo.loadbalancer.server.port=3000
Label=traefik.http.routers.forgejo.middlewares=crowdsec
#Label=crowdsec.enable=true
#Label=crowdsec.labels.type=gitea
Network=net-proxy.network
Network=net-postgres.network
Network=net-redis.network
PublishPort=22:22
Volume=/data/forgejo/data:/var/lib/forgejo
Volume=/data/forgejo/config:/etc/forgejo
Volume=/etc/localtime:/etc/localtime:ro
