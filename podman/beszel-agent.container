[Unit]
After=podman.socket
BindsTo=podman.socket

[Container]
AddCapability=SYS_RAWIO,SYS_ADMIN
AddDevice=/dev/nvme0
AddDevice=/dev/nvme1
AddDevice=/dev/sda
AddDevice=/dev/sdb
AddDevice=/dev/sdc
AddDevice=/dev/sdd
ContainerName=beszel-agent
Environment=LISTEN=45876
Environment=DOCKER_HOST=unix:///var/run/podman.sock
Environment=HUB_URL=https://beszel.internal.${MAIN_DOMAIN}
EnvironmentFile=/etc/secc/env/beszel-agent.env
HealthCmd=["/agent","health"]
HealthStartPeriod=5s
Image=ghcr.io/henrygd/beszel/beszel-agent:0.21-alpine
Network=host
Volume=/.beszel:/extra-filesystems/disk1:ro
Volume=/data/.beszel:/extra-filesystems/disk3:ro
Volume=/data/beszel_agent:/var/lib/beszel-agent
Volume=/podman_data/.beszel:/extra-filesystems/disk4:ro
Volume=/var/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro
Volume=/var/run/podman/podman.sock:/var/run/podman.sock:ro
